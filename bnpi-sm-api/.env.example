NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
TRUST_PROXY=0

# --- PostgreSQL (optional until you need persistence) ---
# Local Docker (docker compose up postgres -d):
DATABASE_URL=postgresql://bnpi:bnpi@localhost:5432/bnpi_sm
# Leave empty to run API without a database (postgres readiness = disabled)
# DATABASE_URL=
DATABASE_POOL_MAX=10
# Set to the same Postgres URL to opt Jest into DB-backed tests (auth/rooms/bookings suites).
# TEST_DATABASE_URL=postgresql://bnpi:bnpi@localhost:5432/bnpi_sm

# --- Auth (BDSS) ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_JWT_SECRET=
AUTH_JWT_EXPIRES_IN=12h
# Biometric check-in provider. Only "manual" (staff-confirmed) exists today;
# a future hardware-backed provider would add a new enum value + implementation.
BIOMETRICS_PROVIDER=manual

# --- Redis (optional) ---
# Leave empty to disable Redis (in-memory rate limit + cache fallback in non-prod)
REDIS_URL=

# Comma-separated browser origins. Include the SPA origin — Vite dev (5173)
# and Playwright's preview server for `npm run test:e2e` in bnpi-sm-app (4173).
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Global /api rate limit (health + docs are skipped)
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_REQUESTS=150
