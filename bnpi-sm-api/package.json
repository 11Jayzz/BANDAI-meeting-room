{
  "name": "bnpi-sm-api",
  "version": "0.1.0",
  "description": "BNPI SM API — senior Express + TypeScript modular scaffold with WWG multi-agent workflows",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "ts-node-dev --respawn --transpile-only server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "jest --runInBand --passWithNoTests=false",
    "test:watch": "jest --watch",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run feature:doctor && npm run ai:guard && npm run wwg:validate && npm run wwg:ci:validate",
    "db:up": "docker compose up postgres -d",
    "db:down": "docker compose stop postgres",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "db:status": "node scripts/db-status.mjs",
    "db:generate": "drizzle-kit generate",
    "prepare": "husky || true",
    "wwg": "wwg",
    "wwg:status": "wwg status --format plain",
    "wwg:brief": "node scripts/wwg-brief.mjs",
    "wwg:brief:generic": "wwg brief generic --format plain",
    "wwg:brief:grok": "wwg brief grok --format plain",
    "wwg:brief:claude": "wwg brief claude-code --format plain",
    "wwg:brief:codex": "wwg brief codex --format plain",
    "wwg:brief:cursor": "wwg brief cursor --format plain",
    "wwg:validate": "wwg validate --format plain",
    "wwg:maintain": "wwg maintain --format plain",
    "wwg:doctor": "wwg doctor --format plain",
    "wwg:doctor:apply": "wwg doctor --apply --format plain",
    "wwg:governance": "wwg generate-governance --format plain",
    "wwg:ci:validate": "wwg ci validate",
    "wwg:ci:lint": "wwg ci lint",
    "wwg:readme:validate": "wwg readme validate --format plain",
    "wwg:changelog:preview": "wwg changelog generate --from-git --weekly --dry-run --format plain",
    "wwg:intake": "node scripts/wwg-intake.mjs",
    "wwg:plan": "wwg dev plan --from intake.answers.yaml --format plain",
    "wwg:refresh": "wwg dev refresh context --format plain",
    "wwg:reconcile": "node scripts/wwg-intake.mjs && wwg dev plan --from intake.answers.yaml --format plain && wwg generate-governance --format plain && wwg doctor --apply --format plain && wwg validate --format plain && node scripts/wwg-brief.mjs",
    "feature:new": "node scripts/new-feature.mjs",
    "feature:update": "node scripts/feature-update.mjs",
    "feature:done": "node scripts/feature-done.mjs",
    "feature:doctor": "node scripts/feature-doctor.mjs",
    "ai:guard": "node scripts/ai-sloppy-guard.mjs",
    "ai:guard:list": "node scripts/ai-sloppy-guard.mjs --list"
  },
  "keywords": [
    "bnpi",
    "api",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "rate-limit-redis": "^4.3.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bnpi/anti-slop": "github:g-zenr/anti-slop",
    "@homedesk/wwg": "^0.6.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "oxlint": "^1.71.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
