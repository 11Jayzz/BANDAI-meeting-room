{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": ".",
    "outDir": "./dist",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "*.ts",
    "config",
    "db",
    "helper",
    "lib",
    "middleware",
    "modules",
    "schema",
    "types/**/*.d.ts",
    "utils"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}
