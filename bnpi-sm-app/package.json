{
  "name": "bnpi-sm-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:open": "playwright test --headed --workers=1",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "wwg": "wwg",
    "wwg:status": "wwg status --format plain",
    "wwg:brief": "node scripts/wwg-brief.mjs",
    "wwg:brief:generic": "wwg brief generic --format plain",
    "wwg:brief:grok": "wwg brief grok --format plain",
    "wwg:brief:claude": "wwg brief claude-code --format plain",
    "wwg:brief:codex": "wwg brief codex --format plain",
    "wwg:brief:cursor": "wwg brief cursor --format plain",
    "wwg:validate": "wwg validate --format plain",
    "wwg:maintain": "wwg maintain --format plain",
    "wwg:doctor": "wwg doctor --format plain",
    "wwg:doctor:apply": "wwg doctor --apply --format plain",
    "wwg:governance": "wwg generate-governance --format plain",
    "wwg:ci:validate": "wwg ci validate --format plain",
    "wwg:ci:lint": "wwg ci lint --format plain",
    "wwg:readme:validate": "wwg readme validate --format plain",
    "wwg:changelog:preview": "wwg changelog generate --from-git --weekly --dry-run --format plain",
    "wwg:intake": "node scripts/wwg-intake.mjs",
    "wwg:plan": "wwg dev plan --from intake.answers.yaml --format plain",
    "wwg:refresh": "wwg dev refresh context --format plain",
    "wwg:reconcile": "node scripts/wwg-intake.mjs && wwg dev plan --from intake.answers.yaml --format plain && wwg generate-governance --format plain && wwg doctor --apply --format plain && wwg validate --format plain && node scripts/wwg-brief.mjs",
    "feature:new": "node scripts/new-feature.mjs",
    "feature:update": "node scripts/feature-update.mjs",
    "feature:done": "node scripts/feature-done.mjs",
    "feature:doctor": "node scripts/feature-doctor.mjs",
    "ai:guard": "node scripts/ai-sloppy-guard.mjs",
    "ai:guard:list": "node scripts/ai-sloppy-guard.mjs --list",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e && npm run feature:doctor && npm run ai:guard && npm run wwg:validate"
  },
  "description": "BNPI SM frontend template. Agentic features: npm run feature:new -- <slug> --with-e2e --with-page",
  "dependencies": {
    "clsx": "^2.1.1",
    "i18next": "^25.8.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^16.5.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@bnpi/anti-slop": "github:g-zenr/anti-slop",
    "@homedesk/wwg": "^0.6.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.0.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.18"
  }
}
